# Copy to /etc/whut-acm/whut-acm.env and run: chmod 600 /etc/whut-acm/whut-acm.env
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1

MYSQL_URL=jdbc:mysql://127.0.0.1:3306/whut_training?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false
MYSQL_USERNAME=whut_acm
MYSQL_PASSWORD=replace-with-a-long-random-password

SUPERADMIN_USERNAME=replace-with-a-private-admin-name
SUPERADMIN_PASSWORD=replace-with-a-different-long-random-password

CORS_ALLOWED_ORIGINS=https://acm.example.com
# Temporary HTTP/IP only: explicitly set true and use an exact http://IPv4 origin.
# Passwords and tokens are exposed in transit over HTTP. Switch back to false for HTTPS.
ALLOW_INSECURE_HTTP=false
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=21600
LOGGING_FILE_PATH=/var/log/whut-acm
