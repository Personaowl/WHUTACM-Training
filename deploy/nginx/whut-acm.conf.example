limit_req_zone $binary_remote_addr zone=whut_api:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=whut_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=whut_refresh:10m rate=60r/m;

server {
    listen 80;
    server_name acm.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name acm.example.com;
    server_tokens off;

    # Managed by Certbot after issuing the certificate.
    ssl_certificate /etc/letsencrypt/live/acm.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/acm.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    root /var/www/whut-acm;
    index index.html;
    client_max_body_size 1m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Revalidate the entry page so deployments do not keep pointing at old JS chunks.
    # expires preserves the server-level security headers, unlike a location add_header override.
    location = /index.html {
        expires -1;
        try_files $uri =404;
    }

    # Reject dotfiles before they reach the SPA fallback or Java API.
    location ~ (^|/)\.(?!well-known/) {
        return 404;
    }

    location = /api/auth/login {
        limit_req zone=whut_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/users/register {
        limit_req zone=whut_auth burst=3 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/auth/refresh {
        limit_req zone=whut_refresh burst=20 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        limit_req zone=whut_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location ~* \.(?:css|js|png|jpg|jpeg|webp|gif|svg|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
